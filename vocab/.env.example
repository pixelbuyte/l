# Copy to .env if you want to change anything. No key is needed: with no key
# the app runs fully offline (bundled dictionary + on-device OCR).

# PROVIDER=auto            # auto | offline | ollama | anthropic

# Claude (optional)
# ANTHROPIC_API_KEY=your_api_key_here
# CLAUDE_MODEL=claude-sonnet-5-5   # or claude-haiku-5-5 for lower latency

# Local vision model via Ollama (optional): ollama pull qwen2.5vl
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen2.5vl

# PORT=3000
